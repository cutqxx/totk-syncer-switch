<UserControl x:Class="TotkSync.App.Controls.FieldError"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel Margin="{StaticResource Space.TopS}"
                AutomationProperties.LiveSetting="Assertive"
                Orientation="Horizontal">
        <ui:SymbolIcon VerticalAlignment="Top"
                       Margin="0,2,8,0"
                       FontSize="16"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       Symbol="ErrorCircle16" />
        <TextBlock Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   Text="{Binding Message, ElementName=Root}"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
