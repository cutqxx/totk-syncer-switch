<UserControl x:Class="TotkSync.App.Controls.SettingHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root"
             Focusable="False">
    <StackPanel>
        <ui:TextBlock FontTypography="Body"
                      Text="{Binding Title, ElementName=Root}" />
        <ui:TextBlock Margin="{StaticResource Space.TopXS}"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      FontTypography="Caption"
                      Text="{Binding Description, ElementName=Root}"
                      TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
