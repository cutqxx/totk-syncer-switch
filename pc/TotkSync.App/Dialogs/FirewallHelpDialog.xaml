<ui:ContentDialog x:Class="TotkSync.App.Dialogs.FirewallHelpDialog"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  Title="Allow the Switch to connect"
                  CloseButtonText="Close"
                  DialogMaxWidth="560">
    <StackPanel>
        <TextBlock Text="Windows Firewall blocks incoming connections on Public networks. TotK Save Sync only needs your home (Private) network."
                   TextWrapping="Wrap" />

        <ui:TextBlock Margin="{StaticResource Space.TopM}"
                      FontTypography="BodyStrong"
                      Text="1. If Windows asks about TotK Save Sync, allow it on Private networks."
                      TextWrapping="Wrap" />
        <TextBlock Margin="{StaticResource Space.TopXS}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="If you clicked Cancel in the Windows prompt, allow TotK Save Sync in &quot;Allow an app through firewall&quot;."
                   TextWrapping="Wrap" />

        <ui:TextBlock Margin="{StaticResource Space.TopM}"
                      FontTypography="BodyStrong"
                      Text="2. Make sure this PC's network is set to Private."
                      TextWrapping="Wrap" />
        <ui:Button Margin="{StaticResource Space.TopS}"
                   HorizontalAlignment="Left"
                   Appearance="Secondary"
                   Click="OnOpenNetworkSettingsClick"
                   Content="Open network settings"
                   Icon="{ui:SymbolIcon Open24}" />

        <ui:TextBlock Margin="{StaticResource Space.TopM}"
                      FontTypography="BodyStrong"
                      Text="3. If the Switch still can't connect, run this command in a terminal opened as administrator:"
                      TextWrapping="Wrap" />
        <TextBox Margin="{StaticResource Space.TopS}"
                 AutomationProperties.Name="Firewall command"
                 Background="{DynamicResource ControlFillColorDefaultBrush}"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 FontFamily="Cascadia Mono, Consolas"
                 IsReadOnly="True"
                 Text="{Binding Command, Mode=OneWay}"
                 TextWrapping="Wrap" />
        <ui:Button x:Name="CopyButton"
                   Margin="{StaticResource Space.TopS}"
                   HorizontalAlignment="Right"
                   Appearance="Secondary"
                   AutomationProperties.Name="Copy command"
                   Click="OnCopyClick"
                   Content="Copy"
                   Icon="{ui:SymbolIcon Copy24}" />

        <TextBlock Margin="{StaticResource Space.TopM}"
                   Text="{Binding CheckText, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{Binding HasCheckUrl, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock x:Name="ErrorText"
                   Margin="{StaticResource Space.TopS}"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />
    </StackPanel>
</ui:ContentDialog>
