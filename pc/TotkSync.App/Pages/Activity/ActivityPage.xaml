<Page x:Class="TotkSync.App.Pages.Activity.ActivityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:activity="clr-namespace:TotkSync.App.Pages.Activity"
      xmlns:controls="clr-namespace:TotkSync.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <controls:PageFrame Title="Activity">
        <StackPanel>
            <ui:TextBlock Style="{StaticResource CaptionText}"
                          Text="Requests from the Switch, newest first. The last 500 are kept." />

            <ui:InfoBar Margin="{StaticResource Space.TopM}"
                        IsClosable="False"
                        IsOpen="{Binding IsUnreadable}"
                        Message="New requests are still recorded. Earlier entries may be missing."
                        Severity="Warning"
                        Title="Couldn't read the earlier activity" />

            <StackPanel Margin="{StaticResource Space.TopM}"
                        Orientation="Horizontal"
                        Visibility="{Binding IsLoadingIndicatorVisible, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                <TextBlock Margin="{StaticResource Space.LeftS}"
                           VerticalAlignment="Center"
                           Text="Loading activity…" />
            </StackPanel>

            <controls:EmptyState Title="No requests yet"
                                 Body="When the Switch connects, its requests show up here. This window must stay open."
                                 Symbol="History24"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListView Margin="{StaticResource Space.TopM}"
                      AutomationProperties.Name="Requests from the Switch"
                      ItemsSource="{Binding Rows}"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InvertedBoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="170" Header="Time">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type activity:ActivityRowModel}">
                                    <TextBlock Text="{Binding TimeText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="140" Header="Client">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type activity:ActivityRowModel}">
                                    <TextBlock Style="{StaticResource MachineValueText}" Text="{Binding Client}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="160" Header="Request">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type activity:ActivityRowModel}">
                                    <TextBlock Style="{StaticResource MachineValueText}"
                                               Text="{Binding Request}"
                                               ToolTip="{Binding Request}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="320" Header="Result">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type activity:ActivityRowModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="16" Symbol="{Binding Symbol}" />
                                        <TextBlock Margin="{StaticResource Space.LeftS}" Text="{Binding ResultText}" />
                                        <TextBlock Margin="{StaticResource Space.LeftS}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding CodeText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </controls:PageFrame>
</Page>
