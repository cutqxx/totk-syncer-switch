<Page x:Class="TotkSync.App.Pages.Backups.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:backups="clr-namespace:TotkSync.App.Pages.Backups"
      xmlns:controls="clr-namespace:TotkSync.App.Controls"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <controls:PageFrame Title="Backups">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <ui:Button Command="{Binding OpenFolderCommand}"
                           Content="Open backups folder"
                           DockPanel.Dock="Right"
                           Icon="{ui:SymbolIcon FolderOpen24}" />
                <TextBlock Margin="{StaticResource Space.RightM}"
                           VerticalAlignment="Center"
                           AutomationProperties.HelpText="{Binding FolderText}"
                           Style="{StaticResource MachineValueText}"
                           Text="{Binding FolderText}"
                           ToolTip="{Binding FolderText}" />
            </DockPanel>
            <controls:FieldError Message="{Binding OpenFolderError}"
                                 Visibility="{Binding HasOpenFolderError, Converter={StaticResource BoolToVisibility}}" />

            <ui:InfoBar Margin="{StaticResource Space.TopM}"
                        IsClosable="False"
                        IsOpen="{Binding HasListError, Mode=OneWay}"
                        Message="{Binding ListError}"
                        Severity="Warning"
                        Title="Couldn't list the backups" />

            <controls:EmptyState Title="No backups yet"
                                 Body="A backup of your PC save is made automatically before the Switch replaces it."
                                 Symbol="Archive24"
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListView Margin="{StaticResource Space.TopM}"
                      AutomationProperties.Name="PC save backups, newest first"
                      ItemsSource="{Binding Rows}"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="150" Header="Date">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type backups:BackupRowModel}">
                                    <TextBlock Text="{Binding DateText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="240" Header="Reason">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type backups:BackupRowModel}">
                                    <TextBlock Text="{Binding ReasonText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100" Header="Size">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type backups:BackupRowModel}">
                                    <TextBlock Text="{Binding SizeText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="330" Header="File">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type backups:BackupRowModel}">
                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource MachineValueText}"
                                               Text="{Binding FileName}"
                                               ToolTip="{Binding FileName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <ui:TextBlock Margin="{StaticResource Space.TopM}"
                          Style="{StaticResource CaptionText}"
                          Text="{Binding KeepingText}" />
        </StackPanel>
    </controls:PageFrame>
</Page>
