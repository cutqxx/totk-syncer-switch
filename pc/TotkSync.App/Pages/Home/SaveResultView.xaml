<UserControl x:Class="TotkSync.App.Pages.Home.SaveResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="clr-namespace:TotkSync.App.Pages.Home"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="StatusIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Caution}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Attention}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Visibility="{Binding Card.HasStatus, Converter={StaticResource BoolToVisibility}}">
        <StackPanel AutomationProperties.LiveSetting="Polite" Orientation="Horizontal">
            <ui:SymbolIcon Style="{StaticResource StatusIcon}" Symbol="{Binding Card.Symbol}" />
            <ui:TextBlock Margin="{StaticResource Space.LeftS}"
                          VerticalAlignment="Center"
                          FontTypography="BodyStrong"
                          Text="{Binding Card.Word}" />
        </StackPanel>

        <TextBlock Margin="{StaticResource Space.TopS}"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Text="{Binding Card.Detail}"
                   TextWrapping="Wrap"
                   Visibility="{Binding Card.HasDetail, Converter={StaticResource BoolToVisibility}}" />

        <ui:Button Margin="{StaticResource Space.TopSM}"
                   Appearance="Secondary"
                   Command="{Binding OpenSettingsCommand}"
                   Content="Open Settings"
                   Icon="{ui:SymbolIcon Settings24}"
                   Visibility="{Binding Card.IsNotFound, Converter={StaticResource BoolToVisibility}}" />

        <Grid Margin="{StaticResource Space.TopM}"
              Visibility="{Binding Card.IsFound, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Folder" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               AutomationProperties.HelpText="{Binding Card.Folder}"
                               AutomationProperties.Name="PC save folder"
                               Style="{StaticResource MachineValueText}"
                               Text="{Binding Card.Folder}"
                               ToolTip="{Binding Card.Folder}" />
                    <ui:Button Grid.Column="1"
                               Margin="{StaticResource Space.LeftS}"
                               Appearance="Transparent"
                               AutomationProperties.Name="Open save folder"
                               Command="{Binding OpenSaveFolderCommand}"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               ToolTip="Open folder" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="{StaticResource Space.TopSM}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Modified" />
                <TextBlock Text="{Binding Card.Modified}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Margin="{StaticResource Space.TopSM}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Files" />
                <TextBlock Text="{Binding Card.FilesText}" />
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="{StaticResource Space.TopSM}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Fingerprint" />
                <TextBlock AutomationProperties.Name="Fingerprint"
                           Style="{StaticResource MachineValueText}"
                           Text="{Binding Card.FingerprintPreview}"
                           ToolTip="{Binding Card.FingerprintFull}" />
            </StackPanel>
        </Grid>

        <ItemsControl Margin="{StaticResource Space.TopM}"
                      ItemsSource="{Binding Card.Candidates}"
                      Visibility="{Binding Card.IsSeveral, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type home:CandidateRow}">
                    <Grid Margin="{StaticResource Space.TopS}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource MachineValueText}"
                                       Text="{Binding Dir}"
                                       ToolTip="{Binding Dir}" />
                            <ui:TextBlock Style="{StaticResource CaptionText}" Text="{Binding ModifiedText}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Margin="{StaticResource Space.LeftS}"
                                   Appearance="Secondary"
                                   Command="{Binding DataContext.UseCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                   CommandParameter="{Binding Dir}"
                                   Content="Use this folder" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ui:Button Margin="{StaticResource Space.TopSM}"
                   Appearance="Transparent"
                   Command="{Binding OpenSettingsCommand}"
                   Content="Open Settings"
                   Visibility="{Binding Card.IsSeveral, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
