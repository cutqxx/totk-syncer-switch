<UserControl x:Class="TotkSync.App.Pages.Home.ServerCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:TotkSync.App.Controls"
             xmlns:home="clr-namespace:TotkSync.App.Pages.Home"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ServerStatusIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Success}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Caution}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Card.Tone}" Value="{x:Static home:StatusTone.Critical}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ui:Card Padding="{StaticResource Space.CardPadding}">
        <StackPanel>
            <StackPanel Margin="{StaticResource Space.BottomSM}" Orientation="Horizontal">
                <ui:SymbolIcon FontSize="20" Symbol="Server20" />
                <ui:TextBlock Margin="{StaticResource Space.LeftS}"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Text="Server" />
            </StackPanel>

            <StackPanel AutomationProperties.LiveSetting="Polite" Orientation="Horizontal">
                <ui:ProgressRing Width="20"
                                 Height="20"
                                 IsIndeterminate="True"
                                 Visibility="{Binding Card.IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ui:SymbolIcon Style="{StaticResource ServerStatusIcon}"
                               Symbol="{Binding Card.Symbol}"
                               Visibility="{Binding Card.IsBusy, Converter={StaticResource InvertedBoolToVisibility}}" />
                <ui:TextBlock Margin="{StaticResource Space.LeftS}"
                              VerticalAlignment="Center"
                              FontTypography="BodyStrong"
                              Text="{Binding Card.Word}" />
            </StackPanel>

            <TextBlock Margin="{StaticResource Space.TopS}"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Card.Detail}"
                       TextWrapping="Wrap"
                       Visibility="{Binding Card.HasDetail, Converter={StaticResource BoolToVisibility}}" />

            <StackPanel Margin="{StaticResource Space.TopSM}"
                        Orientation="Horizontal"
                        Visibility="{Binding Card.IsError, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Secondary"
                           Command="{Binding RetryCommand}"
                           Content="Retry"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button Margin="{StaticResource Space.LeftS}"
                           Appearance="Secondary"
                           Command="{Binding ChangePortCommand}"
                           Content="Change port" />
            </StackPanel>

            <StackPanel Margin="{StaticResource Space.TopM}"
                        Visibility="{Binding Card.HasSingleAddress, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Address for Switch" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               AutomationProperties.Name="Address for Switch"
                               Style="{StaticResource MachineValueText}"
                               Text="{Binding Card.FirstUrl}"
                               ToolTip="{Binding Card.FirstUrl}" />
                    <ui:Button Grid.Column="1"
                               Margin="{StaticResource Space.LeftS}"
                               Appearance="Secondary"
                               AutomationProperties.Name="Copy address"
                               Command="{Binding CopyAddressCommand}"
                               Icon="{ui:SymbolIcon Copy24}"
                               ToolTip="Copy address" />
                </Grid>
            </StackPanel>

            <StackPanel Margin="{StaticResource Space.TopM}"
                        Visibility="{Binding Card.HasSeveralAddresses, Converter={StaticResource BoolToVisibility}}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Address for Switch" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox AutomationProperties.Name="Address for Switch"
                              DisplayMemberPath="Url"
                              ItemsSource="{Binding Card.Addresses}"
                              SelectedItem="{Binding SelectedAddress}" />
                    <ui:Button Grid.Column="1"
                               Margin="{StaticResource Space.LeftS}"
                               Appearance="Secondary"
                               AutomationProperties.Name="Copy address"
                               Command="{Binding CopyAddressCommand}"
                               Icon="{ui:SymbolIcon Copy24}"
                               ToolTip="Copy address" />
                </Grid>
            </StackPanel>

            <StackPanel Margin="{StaticResource Space.TopM}" DataContext="{Binding Pairing}">
                <ui:TextBlock Style="{StaticResource CaptionText}" Text="Token" />
                <TextBlock Padding="8,6"
                           AutomationProperties.Name="Token"
                           Background="{DynamicResource ControlFillColorDefaultBrush}"
                           Style="{StaticResource MachineValueText}"
                           Text="{Binding TokenText}"
                           TextWrapping="Wrap" />
                <StackPanel Margin="{StaticResource Space.TopS}" Orientation="Horizontal">
                    <ui:Button Appearance="Secondary"
                               AutomationProperties.Name="Show token"
                               Command="{Binding ToggleTokenCommand}"
                               Content="Show"
                               Icon="{ui:SymbolIcon Eye24}"
                               Visibility="{Binding IsTokenVisible, Converter={StaticResource InvertedBoolToVisibility}}" />
                    <ui:Button Appearance="Secondary"
                               AutomationProperties.Name="Hide token"
                               Command="{Binding ToggleTokenCommand}"
                               Content="Hide"
                               Icon="{ui:SymbolIcon EyeOff24}"
                               Visibility="{Binding IsTokenVisible, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Margin="{StaticResource Space.LeftS}"
                               Appearance="Secondary"
                               AutomationProperties.Name="Copy token"
                               Command="{Binding CopyTokenCommand}"
                               Content="_Copy"
                               Icon="{ui:SymbolIcon Copy24}" />
                </StackPanel>

                <ui:Button Margin="{StaticResource Space.TopM}"
                           Appearance="Secondary"
                           Command="{Binding SaveSwitchConfigCommand}"
                           Content="_Save switch-config.json…"
                           Icon="{ui:SymbolIcon ArrowDownload24}" />
                <ui:Button Margin="{StaticResource Space.TopS}"
                           Appearance="Secondary"
                           Command="{Binding ShowFirewallHelpCommand}"
                           Content="_Firewall help"
                           Icon="{ui:SymbolIcon Shield24}" />

                <controls:FieldError Message="{Binding PairingError}" />

                <ui:InfoBar Title="switch-config.json saved"
                            AutomationProperties.LiveSetting="Polite"
                            Margin="{StaticResource Space.TopS}"
                            IsClosable="True"
                            IsOpen="{Binding IsSavedVisible, Mode=TwoWay}"
                            Message="Copy it to the SD card as sd:/config/totk-sync/config.json. It contains your token, so don't share it."
                            Severity="Success">
                    <ui:Button Appearance="Secondary"
                               Command="{Binding OpenSavedFolderCommand}"
                               Content="Open folder" />
                </ui:InfoBar>
            </StackPanel>

            <ui:TextBlock Margin="{StaticResource Space.TopM}"
                          Style="{StaticResource CaptionText}"
                          Text="{Binding LastRequestText}" />
        </StackPanel>
    </ui:Card>
</UserControl>
