<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.SM">12</sys:Double>
    <sys:Double x:Key="Space.M">16</sys:Double>
    <sys:Double x:Key="Space.L">24</sys:Double>
    <sys:Double x:Key="Space.XL">32</sys:Double>
    <sys:Double x:Key="Space.XXL">48</sys:Double>

    <Thickness x:Key="Space.PagePadding">32,24,32,32</Thickness>
    <Thickness x:Key="Space.CardPadding">16</Thickness>
    <Thickness x:Key="Space.HeroPadding">24</Thickness>

    <Thickness x:Key="Space.TopXS">0,4,0,0</Thickness>
    <Thickness x:Key="Space.TopS">0,8,0,0</Thickness>
    <Thickness x:Key="Space.TopSM">0,12,0,0</Thickness>
    <Thickness x:Key="Space.TopM">0,16,0,0</Thickness>
    <Thickness x:Key="Space.TopL">0,24,0,0</Thickness>
    <Thickness x:Key="Space.TopXL">0,32,0,0</Thickness>
    <Thickness x:Key="Space.BottomSM">0,0,0,12</Thickness>
    <Thickness x:Key="Space.LeftS">8,0,0,0</Thickness>
    <Thickness x:Key="Space.RightS">0,0,8,0</Thickness>
    <Thickness x:Key="Space.RightM">0,0,16,0</Thickness>
</ResourceDictionary>
