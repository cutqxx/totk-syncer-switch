<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:TotkSync.App.Controls"
                    xmlns:home="clr-namespace:TotkSync.App.Pages.Home">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <controls:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibility" />
    <home:SaveCardIconConverter x:Key="SaveCardIconToSymbol" />

    <Style x:Key="CaptionText" TargetType="{x:Type ui:TextBlock}">
        <Setter Property="FontTypography" Value="Caption" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="MachineValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style TargetType="{x:Type controls:PageFrame}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageFrame}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="{StaticResource Space.PagePadding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MaxWidth="1080" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ui:TextBlock FontTypography="Title" Text="{TemplateBinding Title}" />
                                <ContentPresenter Margin="{StaticResource Space.TopL}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
